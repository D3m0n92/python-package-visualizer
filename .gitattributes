# Normalize line endings to LF (matches .vscode/settings.json "files.eol").
* text=auto eol=lf

# Text sources
*.cjs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.mjs text eol=lf
*.ps1 text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.svg text eol=lf
*.toml text eol=lf
*.ts text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary assets
*.gif binary
*.ico binary
*.jpeg binary
*.jpg binary
*.png binary
*.vsix binary
*.webp binary
